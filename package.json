{
  "name": "frontend-neo",
  "version": "1.0.0",
  "description": "Frontend for GenZZ Library",
  "scripts": {
    "start": "http-server -p 8080",
    "lint": "eslint js/*.js",
    "format": "prettier --write \"**/*.{js,html,css}\"",
    "build": "terser js/*.js --compress --mangle --output dist/js/ && cp -r assets dist/ && cp *.html dist/"
  },
  "devDependencies": {
    "eslint": "^9.13.0",
    "http-server": "^14.1.1",
    "prettier": "^3.3.3",
    "terser": "^5.36.0"
  },
  "author": "GenZZ-Coders",
  "license": "MIT"
}
